{
    "$comment": "Read-aloud audio (Kokoro TTS). Generated by `npm run tts`, which `npm run publish` runs too. Voices: https://huggingface.co/hexgrad/Kokoro-82M/blob/main/VOICES.md — ids starting with 'a' are US English, 'b' British English. Changing voices, speed, model or a pronunciation regenerates only the affected sentences.",
    "model": "kokoro-82m-v1.0",
    "voices": [
        { "id": "af_heart", "label": "Heart (US, female)" }
    ],
    "speed": 1.0,
    "pauses": { "sentence": 0.3, "paragraph": 0.6, "heading": 0.9 },
    "mp3Quality": 0.7,

    "$comment_skipSections": "Headings whose whole section (up to the next heading of the same or higher level) is not read. Case-insensitive.",
    "skipSections": ["References", "Key References"],

    "$comment_pronunciations": "How things are spoken; the page text is unchanged. Literal replacements, longest first.",
    "pronunciations": {
        "V̇CO₂/V̇O₂": "VCO₂ over VO₂",
        "V̇": "V",
        "PaCO₂": "P.A.C.O. two",
        "PO₂": "P.O. two",
        "→": " to ",
        "↑": " increased ",
        "↓": " decreased ",
        "kcal·kg·h⁻¹": "kilocalories per kilogram per hour",
        "MET·min·wk⁻¹": "MET minutes per week"
    },

    "$comment_patterns": "Regular expressions [pattern, replacement], applied in order after the literal replacements.",
    "patterns": [
        ["(?<![A-Za-z])CO[₂2](?![0-9])", " C.O. two"],
        ["·?\\bmin⁻¹", " per minute"],
        ["·?\\bkg⁻¹", " per kilogram"],
        ["·?\\bg⁻¹", " per gram"],
        ["·?\\bL⁻¹", " per liter"],
        ["·?\\bh⁻¹", " per hour"],
        ["·?\\bwk⁻¹", " per week"],
        ["·?\\bd⁻¹", " per day"],
        ["·?\\bday⁻¹", " per day"],
        ["·?\\bm⁻²", " per square meter"],
        ["·?\\bmmHg⁻¹", " per millimeter of mercury"],
        ["·?\\bs⁻¹", " per second"],
        ["·", " "],
        ["\\b[mM][lL]\\b", "milliliters"],
        ["(\\d)\\s?l\\b", "$1 liters"],
        ["\\bl per\\b", "liters per"],
        ["(\\d)\\s?W\\b", "$1 watts"],
        ["(\\d)\\s?cm\\b", "$1 centimeters"],
        ["\\bmmol\\b", "millimoles"],
        ["\\bkcal\\b", "kilocalories"],
        ["(\\d)\\s?kg\\b", "$1 kilograms"],
        ["(\\d)\\s?g\\b", "$1 grams"],
        ["\\bkg\\b", "kilograms"],
        ["\\bHRmax\\b", "HR max"],
        ["\\bAMPK\\b", "A M P K"]
    ]
}
